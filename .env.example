# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=printmydoc

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Razorpay (test/sandbox keys — get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# App
# Optional. QR codes and WhatsApp links detect the site's own URL from the
# incoming request (works automatically on localhost, a server IP, or a
# domain). Only set this to force a specific URL, e.g. if you put the app
# behind a reverse proxy/CDN that doesn't forward the original host.
NEXT_PUBLIC_APP_URL=

# At-rest encryption for stored secrets (WhatsApp access tokens, etc.)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# WhatsApp Cloud API (Meta) — official API only, no unofficial QR pairing
WHATSAPP_VERIFY_TOKEN=change-this-verify-token

# SMTP for transactional emails (leave blank to disable email sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Seeded shop owner login (used by scripts/seed.js)
SEED_SHOP_EMAIL=rahulkumarsharmasharma6694@gmail.com
SEED_SHOP_PASSWORD=System@123

# Seeded super admin login (used by scripts/seed.js)
SEED_ADMIN_EMAIL=admin@printmydoc.local
SEED_ADMIN_PASSWORD=SuperAdmin@123
