{
  "name": "printmydoc-agent",
  "productName": "PrintMyDoc Agent",
  "version": "1.0.0",
  "private": true,
  "description": "Local print agent for PrintMyDoc — detects installed printers and prints queued orders.",
  "main": "index.js",
  "bin": "index.js",
  "scripts": {
    "start": "node index.js",
    "build": "node build.js"
  },
  "dependencies": {
    "dotenv": "16.4.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.16.1"
  },
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64",
      "node18-linux-x64",
      "node18-linux-arm64"
    ],
    "outputPath": "dist"
  }
}
